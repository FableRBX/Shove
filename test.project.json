{
	"name": "push-a-giant-test",
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json", "**/*.server.luau", "**/*.client.luau"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": { "$path": "node_modules/@rbxts" },
					"@rbxts-js": { "$path": "node_modules/@rbxts-js" },
					"@flamework": { "$path": "node_modules/@flamework" }
				}
			},
			"TS": {
				"$path": "out/shared",
				"jest-setup": { "$path": "scripts/jest-setup.luau" }
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"TS": { "$path": "out/server" }
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"TS": { "$path": "out/client" }
			}
		}
	}
}
